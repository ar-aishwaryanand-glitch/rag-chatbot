# RAG Agent Assistant - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ==============================================
# REQUIRED - LLM API Keys
# ==============================================

# OpenAI API Key (for embeddings and LLM)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Groq API Key (alternative LLM provider)
# Get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ==============================================
# OPTIONAL - Web Search
# ==============================================

# Tavily API for web search (free tier: 1000 searches/month)
# Get key at: https://tavily.com
TAVILY_API_KEY=

# News API for news search (free tier: 100 requests/day)
# Get key at: https://newsapi.org
NEWSAPI_KEY=

# ==============================================
# VECTOR DATABASE
# ==============================================

# Set to true to use Pinecone instead of local FAISS
USE_PINECONE=false

# Pinecone Configuration (Optional - for production)
# Get API key from https://app.pinecone.io
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_INDEX_NAME=rag-agent
# PINECONE_NAMESPACE=
# PINECONE_METRIC=cosine
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# ==============================================
# POSTGRESQL DATABASE
# ==============================================

# Set to true to enable PostgreSQL backend
USE_POSTGRES=false

# Option 1: Full connection string (recommended)
# DATABASE_URL=postgresql://user:password@host:port/database

# Option 2: Individual parameters
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=rag_chatbot

# Supabase (cloud PostgreSQL)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key

# ==============================================
# CONFLUENCE INTEGRATION
# ==============================================

CONFLUENCE_ENABLED=false
# CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
# CONFLUENCE_USERNAME=your-email@example.com
# CONFLUENCE_API_TOKEN=your_api_token_here
# CONFLUENCE_SPACE_KEY=MYSPACE

# ==============================================
# REDIS MESSAGE QUEUE
# ==============================================

# Set to true for distributed agent coordination
USE_REDIS_QUEUE=false
# REDIS_URL=redis://localhost:6379/0

# ==============================================
# LANGGRAPH CHECKPOINTS
# ==============================================

# Requires USE_POSTGRES=true
USE_CHECKPOINTS=true

# ==============================================
# POLICY ENGINE
# ==============================================

# Controls tool usage, rate limits, content filtering
USE_POLICY_ENGINE=true

# ==============================================
# OBSERVABILITY (OpenTelemetry)
# ==============================================

ENABLE_OBSERVABILITY=false
# OTEL_SERVICE_NAME=rag-agent
# OTEL_ENVIRONMENT=development
# OTEL_EXPORTER_TYPE=console
# OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# ==============================================
# FEATURE FLAGS
# ==============================================

# Enable code execution tool (security risk)
CODE_EXECUTOR_ENABLED=false

# Enable file operations tool (security risk)
FILE_OPS_ENABLED=false

# ==============================================
# OTHER CONFIGURATION
# ==============================================

# EMBEDDING_MODEL=models/embedding-001
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=100
# MAX_FILE_SIZE_MB=10
